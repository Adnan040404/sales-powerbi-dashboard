model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US

annotation PBI_QueryOrder = ["DataFolder","fact_sales","dim_date","dim_product"]

ref table fact_sales
ref table dim_date
ref table dim_product
ref table _Measures

ref expression DataFolder
